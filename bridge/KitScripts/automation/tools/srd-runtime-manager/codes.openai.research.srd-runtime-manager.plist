<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>codes.openai.research.srd-runtime-manager</string>
  <key>ProgramArguments</key><array>
    <string>/usr/libexec/ellekit/srd-runtime-manager-launcher</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/var/mobile/Library/Logs/srd-runtime-manager.stdout.log</string>
  <key>StandardErrorPath</key><string>/var/mobile/Library/Logs/srd-runtime-manager.stderr.log</string>
</dict></plist>
