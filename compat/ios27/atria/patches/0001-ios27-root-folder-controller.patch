diff --git a/src/Manager/ARITweakManager.m b/src/Manager/ARITweakManager.m
index 9f08730..e27c287 100644
--- a/src/Manager/ARITweakManager.m
+++ b/src/Manager/ARITweakManager.m
@@ -518,11 +518,53 @@ - (void)onSpringboardLaunched {
 }
 
 - (SBRootFolderView *)rootFolderView {
-    return [[[objc_getClass("SBIconController") sharedInstance] _rootFolderController] rootFolderView];
+    SBRootFolderController *controller = [self rootFolderController];
+    if(!controller) return nil;
+
+    if([controller respondsToSelector:@selector(rootFolderViewIfLoaded)]) {
+        SBRootFolderView *loaded = [controller rootFolderViewIfLoaded];
+        if(loaded) return loaded;
+    }
+    return [controller respondsToSelector:@selector(rootFolderView)]
+        ? [controller rootFolderView]
+        : nil;
+}
+
+- (SBRootFolderController *)rootFolderController {
+    SBIconController *iconController = [objc_getClass("SBIconController") sharedInstance];
+    if(!iconController) return nil;
+
+    // iOS 13-16 exposed this controller directly on SBIconController. iOS 27
+    // moved it to SBHIconManager; calling the removed selector aborts SpringBoard.
+    if([iconController respondsToSelector:@selector(_rootFolderController)]) {
+        return [iconController _rootFolderController];
+    }
+
+    SBHIconManager *iconManager = [iconController respondsToSelector:@selector(iconManager)]
+        ? [iconController iconManager]
+        : nil;
+    if([iconManager respondsToSelector:@selector(rootFolderController)]) {
+        return [iconManager rootFolderController];
+    }
+
+    UIViewController *root = [iconManager respondsToSelector:@selector(rootViewController)]
+        ? [iconManager rootViewController]
+        : nil;
+    return [root isKindOfClass:objc_getClass("SBRootFolderController")]
+        ? (SBRootFolderController *)root
+        : nil;
+}
+
+- (UIViewController *)presentationController {
+    SBIconController *iconController = [objc_getClass("SBIconController") sharedInstance];
+    if([iconController isKindOfClass:[UIViewController class]]) {
+        return (UIViewController *)iconController;
+    }
+    return [self rootFolderController];
 }
 
 - (NSArray<SBIconListView *> *)allRootListViews {
-    return [self rootFolderView].iconListViews;
+    return [self rootFolderView].iconListViews ?: @[];
 }
 
