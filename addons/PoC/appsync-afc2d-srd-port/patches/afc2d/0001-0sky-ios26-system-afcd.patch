+static bool ImageRangeIsInText(uintptr_t offset, size_t size,
+    uintptr_t textOffset, size_t textSize)
+{
+    return size <= textSize && offset >= textOffset
+        && offset - textOffset <= textSize - size;
+}
+
+static bool LockdownBuildMatches(const struct mach_header_64 *header)
+{
+    if (header == NULL || header->magic != MH_MAGIC_64) {
+        return false;
+    }
+
+    const uint8_t *cursor = (const uint8_t *)header + sizeof(*header);
+    if (header->sizeofcmds > 16 * 1024 * 1024
+            || (uintptr_t)cursor + header->sizeofcmds < (uintptr_t)cursor) {
+        return false;
+    }
+    const uint8_t *commandsEnd = cursor + header->sizeofcmds;
+    bool uuidMatched = false;
+    bool foundText = false;
+    uintptr_t textOffset = 0;
+    size_t textSize = 0;
+    for (uint32_t index = 0; index < header->ncmds; ++index) {
+        if ((size_t)(commandsEnd - cursor) < sizeof(struct load_command)) {
+            return false;
+        }
+        const struct load_command *command = (const struct load_command *)cursor;
+        if (command->cmdsize < sizeof(*command)
+                || command->cmdsize > (size_t)(commandsEnd - cursor)) {
+            return false;
+        }
+        if (command->cmd == LC_UUID && command->cmdsize >= sizeof(struct uuid_command)) {
+            const struct uuid_command *uuid = (const struct uuid_command *)command;
+            uuidMatched = memcmp(uuid->uuid, kExpectedLockdownUUID,
+                sizeof(kExpectedLockdownUUID)) == 0;
+        }
+        if (command->cmd == LC_SEGMENT_64
+                && command->cmdsize >= sizeof(struct segment_command_64)) {
+            const struct segment_command_64 *segment =
+                (const struct segment_command_64 *)command;
+            size_t sectionBytes = (size_t)segment->nsects * sizeof(struct section_64);
+            if (sectionBytes / sizeof(struct section_64) != segment->nsects
+                    || sizeof(*segment) + sectionBytes > command->cmdsize) {
+                return false;
+            }
+            if (strncmp(segment->segname, "__TEXT", sizeof(segment->segname)) == 0) {
+                const struct section_64 *sections =
+                    (const struct section_64 *)(segment + 1);
+                for (uint32_t sectionIndex = 0;
+                        sectionIndex < segment->nsects; ++sectionIndex) {
+                    const struct section_64 *section = &sections[sectionIndex];
+                    if (strncmp(section->sectname, "__text",
+                            sizeof(section->sectname)) == 0
+                            && strncmp(section->segname, "__TEXT",
+                            sizeof(section->segname)) == 0) {
+                        if (section->addr < segment->vmaddr
+                                || section->size > SIZE_MAX) {
+                            return false;
+                        }
+                        textOffset = (uintptr_t)(section->addr - segment->vmaddr);
+                        textSize = (size_t)section->size;
+                        foundText = true;
+                    }
+                }
+            }
+        }
+        cursor += command->cmdsize;
+    }
+
+    if (cursor != commandsEnd || !uuidMatched || !foundText
+            || kCFRunLoopReturnOffset < sizeof(uint32_t)
+            || !ImageRangeIsInText(kCFRunLoopReturnOffset - sizeof(uint32_t),
+                sizeof(uint32_t), textOffset, textSize)
+            || !ImageRangeIsInText(kServiceArkAddEntryOffset,
+                2 * sizeof(uint32_t), textOffset, textSize)
+            || !ImageRangeIsInText(kExpectedMainSequenceOffset,
+                sizeof(kExpectedMainSequenceInstructions), textOffset, textSize)
+            || kServiceArkInMainFrameOffset == 0
+            || (kServiceArkInMainFrameOffset & (sizeof(uintptr_t) - 1)) != 0
+            || kServiceArkInMainFrameOffset > 4096) {
+        return false;
+    }
+
+    uint32_t runLoopInstruction = 0;
+    uint32_t addEntryInstructions[2] = {};
+    uint32_t mainSequence[4] = {};
+    memcpy(&runLoopInstruction,
+        (const uint8_t *)header + kCFRunLoopReturnOffset - sizeof(uint32_t),
+        sizeof(runLoopInstruction));
+    memcpy(addEntryInstructions,
+        (const uint8_t *)header + kServiceArkAddEntryOffset,
+        sizeof(addEntryInstructions));
+    memcpy(mainSequence, (const uint8_t *)header + kExpectedMainSequenceOffset,
+        sizeof(mainSequence));
+    if (runLoopInstruction != kExpectedRunLoopCallInstruction
+            || addEntryInstructions[0] != kExpectedAddEntryInstruction0
+            || addEntryInstructions[1] != kExpectedAddEntryInstruction1
+            || memcmp(mainSequence, kExpectedMainSequenceInstructions,
+                sizeof(mainSequence)) != 0) {
+        return false;
+    }
+
+    typedef bool (*GetSharedCacheUUIDFunction)(uint8_t *uuid);
+    GetSharedCacheUUIDFunction getSharedCacheUUID =
+        (GetSharedCacheUUIDFunction)dlsym(
+            RTLD_DEFAULT, "_dyld_get_shared_cache_uuid");
+    uint8_t sharedCacheUUID[16] = {};
+    return getSharedCacheUUID != NULL
+        && getSharedCacheUUID(sharedCacheUUID)
+        && memcmp(sharedCacheUUID, kExpectedSharedCacheUUID,
+            sizeof(sharedCacheUUID)) == 0;
+}
+
+static bool ReadTaskMemory(vm_address_t address, void *destination, vm_size_t size)
+{
+    vm_size_t copied = 0;
+    kern_return_t result = vm_read_overwrite(
+        mach_task_self(), address, size, (vm_address_t)destination, &copied);
+    return result == KERN_SUCCESS && copied == size;
+}
+
+static bool HasKnownDictionaryISA(uintptr_t address)
+{
+    static uintptr_t isaMask;
+    static uintptr_t dictionaryClasses[6];
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        uintptr_t *runtimeMask = (uintptr_t *)dlsym(
+            RTLD_DEFAULT, "objc_debug_isa_class_mask");
+        isaMask = runtimeMask != NULL ? *runtimeMask : 0x0000000ffffffff8ULL;
+
+        NSDictionary *empty = @{};
+        NSDictionary *single = @{@"key": @"value"};
+        NSDictionary *multiple = @{@"a": @"1", @"b": @"2"};
+        NSMutableDictionary *mutableDictionary = [NSMutableDictionary dictionary];
+        CFDictionaryRef cfDictionary = CFDictionaryCreate(
+            kCFAllocatorDefault, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CFMutableDictionaryRef cfMutable = CFDictionaryCreateMutable(
+            kCFAllocatorDefault, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        id probes[] = {
+            empty, single, multiple, mutableDictionary,
+            (__bridge id)cfDictionary, (__bridge id)cfMutable,
+        };
+        for (unsigned index = 0; index < 6; ++index) {
+            dictionaryClasses[index] =
+                ((uintptr_t)object_getClass(probes[index])) & isaMask;
+        }
+        CFRelease(cfDictionary);
+        CFRelease(cfMutable);
+    });
+
+    uintptr_t rawISA = 0;
+    if (!ReadTaskMemory(address, &rawISA, sizeof(rawISA))) {
+        return false;
+    }
+    uintptr_t candidateClass = rawISA & isaMask;
+    for (unsigned index = 0; index < 6; ++index) {
+        if (candidateClass != 0 && candidateClass == dictionaryClasses[index]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void *ValidateServiceArkCandidate(uintptr_t candidate)
+{
+    if (candidate < 0x100000000ULL || (candidate & 7) != 0) {
+        return NULL;
+    }
+
+    struct {
+        uintptr_t queue;
+        uintptr_t registry;
+    } fields = {};
+    if (!ReadTaskMemory(candidate, &fields, sizeof(fields))
+            || fields.queue == 0 || fields.registry < 0x100000000ULL
+            || (fields.registry & 7) != 0) {
+        return NULL;
+    }
+    if (malloc_zone_from_ptr((const void *)candidate) == NULL
+            || malloc_zone_from_ptr((const void *)fields.registry) == NULL) {
+        return NULL;
+    }
+    if (malloc_size((const void *)candidate) != 32
+            || !HasKnownDictionaryISA(fields.registry)) {
+        return NULL;
+    }
+    CFDictionaryRef dictionary = (CFDictionaryRef)fields.registry;
+    return CFDictionaryContainsKey(dictionary, CFSTR("com.apple.afc"))
+        ? (void *)candidate : NULL;
+}
+
+static void *ScanThreadStacksForServiceArk(thread_act_array_t threads,
+    mach_msg_type_number_t threadCount)
+{
+    uint8_t page[4096];
+    for (mach_msg_type_number_t index = 0; index < threadCount; ++index) {
+        pthread_t pthread = pthread_from_mach_thread_np(threads[index]);
+        if (pthread == NULL) {
+            continue;
+        }
+        uintptr_t top = (uintptr_t)pthread_get_stackaddr_np(pthread);
+        size_t stackSize = pthread_get_stacksize_np(pthread);
+        if (top == 0 || stackSize == 0 || stackSize > 8 * 1024 * 1024) {
+            continue;
+        }
+        uintptr_t bottom = top - stackSize;
+        for (uintptr_t address = bottom; address < top; address += sizeof(page)) {
+            size_t remaining = top - address;
+            vm_size_t length = (vm_size_t)(remaining < sizeof(page) ? remaining : sizeof(page));
+            if (!ReadTaskMemory(address, page, length)) {
+                continue;
+            }
+            for (vm_size_t offset = 0; offset + sizeof(uintptr_t) <= length;
+                    offset += sizeof(uintptr_t)) {
+                uintptr_t candidate = 0;
+                memcpy(&candidate, page + offset, sizeof(candidate));
+                void *ark = ValidateServiceArkCandidate(candidate);
+                if (ark != NULL) {
+                    return ark;
+                }
+            }
+        }
+    }
+    return NULL;
+}
+
+static void *FindServiceArk(const struct mach_header_64 *header)
+{
+    thread_act_array_t threads = NULL;
+    mach_msg_type_number_t threadCount = 0;
+    if (task_threads(mach_task_self(), &threads, &threadCount) != KERN_SUCCESS) {
+        return NULL;
+    }
+
+    const uintptr_t wantedReturn = (uintptr_t)header + kCFRunLoopReturnOffset;
+    void *ark = NULL;
+    for (mach_msg_type_number_t index = 0; index < threadCount && ark == NULL; ++index) {
+        arm_thread_state64_t state = {};
+        mach_msg_type_number_t stateCount = ARM_THREAD_STATE64_COUNT;
+        if (thread_get_state(threads[index], ARM_THREAD_STATE64,
+                (thread_state_t)&state, &stateCount) != KERN_SUCCESS) {
+            continue;
+        }
+
+        uintptr_t frame = (uintptr_t)arm_thread_state64_get_fp(state);
+        for (unsigned depth = 0; depth < 256 && frame != 0; ++depth) {
+            struct {
+                uintptr_t previous;
+                uintptr_t link;
+            } record = {};
+            if (!ReadTaskMemory(frame, &record, sizeof(record))
+                    || record.previous <= frame
+                    || record.previous - frame > 1024 * 1024) {
+                break;
+            }
+
+            uintptr_t link = (uintptr_t)ptrauth_strip(
+                (void *)record.link, ptrauth_key_return_address);
+            if (link == wantedReturn) {
+                uintptr_t candidate = 0;
+                uintptr_t slot = record.previous - kServiceArkInMainFrameOffset;
+                if (ReadTaskMemory(slot, &candidate, sizeof(candidate)) && candidate != 0) {
+                    uintptr_t registry = 0;
+                    if (ReadTaskMemory(candidate + sizeof(void *), &registry,
+                            sizeof(registry)) && registry != 0) {
+                        ark = ValidateServiceArkCandidate(candidate);
+                    }
+                }
+                break;
+            }
+            frame = record.previous;
+        }
+    }
+
+    if (ark == NULL) {
+        os_log_error(OS_LOG_DEFAULT,
+            "[AFC2] frame-chain lookup missed; scanning pthread stacks");
+        ark = ScanThreadStacksForServiceArk(threads, threadCount);
+    }
+
+    for (mach_msg_type_number_t index = 0; index < threadCount; ++index) {
+        mach_port_deallocate(mach_task_self(), threads[index]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)threads,
+        threadCount * sizeof(thread_t));
+    return ark;
+}
+
+static bool RegisterAFC2(const struct mach_header_64 *header)
+{
+    static void *ark;
+    static bool addScheduled;
+    static bool loaded;
+
+    if (ark == NULL) {
+        ark = FindServiceArk(header);
+    }
+    if (ark == NULL) {
+        return false;
+    }
+
+    uintptr_t registry = 0;
+    if (!ReadTaskMemory((uintptr_t)ark + sizeof(void *), &registry, sizeof(registry))) {
+        return false;
+    }
+    if (CFDictionaryContainsKey((CFDictionaryRef)registry, CFSTR("com.apple.afc2"))) {
+        CFTypeRef registered = CFDictionaryGetValue(
+            (CFDictionaryRef)registry, CFSTR("com.apple.afc2"));
+        os_log_error(OS_LOG_DEFAULT,
+            "[AFC2] live service definition: %{public}@", registered);
+        return true;
+    }
+
+    // service_ark_add_entry dispatches synchronously onto the ark's serial
+    // queue.  Submit once, keep the status storage alive, and let the caller's
+    // next one-second attempt independently verify the resulting registry.
+    if (addScheduled) {
+        return false;
+    }
+
+    ServiceArkAddEntryFunction addEntry =
+        (ServiceArkAddEntryFunction)ptrauth_sign_unauthenticated(
+            (void *)((uintptr_t)header + kServiceArkAddEntryOffset),
+            ptrauth_key_function_pointer, 0
+    );
+    NSDictionary *service = AFC2ServiceDefinition();
+    addScheduled = true;
+    addEntry(ark, (__bridge CFDictionaryRef)service, CFSTR("com.apple.afc2"),
+        (__bridge CFDictionaryRef)service, &loaded);
+    os_log_error(OS_LOG_DEFAULT,
+        "[AFC2] submitted service_ark_add_entry; verification deferred");
+    return false;
+}
+
+%ctor
+{
+    const struct mach_header_64 *header =
+        (const struct mach_header_64 *)_dyld_get_image_header(0);
+    if (!LockdownBuildMatches(header)) {
+        return;
     }
 
-    return (CFPropertyListRef)CFBridgingRetain(origDict);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        for (unsigned attempt = 0; attempt < 30; ++attempt) {
+            if (RegisterAFC2(header)) {
+                os_log_error(OS_LOG_DEFAULT,
+                    "[AFC2] registered com.apple.afc2 through the iOS 27 service ark");
+                return;
+            }
+            [NSThread sleepForTimeInterval:1.0];
+        }
+        os_log_error(OS_LOG_DEFAULT,
+            "[AFC2] could not locate the iOS 27 service ark");
+    });
 }
