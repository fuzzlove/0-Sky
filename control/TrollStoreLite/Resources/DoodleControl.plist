      <key>values</key><array><integer>0</integer><integer>1</integer></array>
      <key>titles</key><array><string>Solid Color</string><string>Transparent</string></array>
      <key>PostNotification</key><string>com.nahtedetihw.doodleprefs/ReloadPrefs</string>
    </dict>
  </array>
