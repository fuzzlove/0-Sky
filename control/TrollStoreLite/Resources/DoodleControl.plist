      <key>default</key><false/>
      <key>PostNotification</key><string>com.nahtedetihw.doodleprefs/ReloadPrefs</string>
    </dict>
    <dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Pattern Options</string></dict>
    <dict>
      <key>cell</key><string>PSLinkListCell</string>
