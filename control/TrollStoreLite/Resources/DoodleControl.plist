<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Unlock Pattern</string></dict>
    <dict>
      <key>cell</key><string>PSLinkCell</string>
      <key>id</key><string>recordingController</string>
