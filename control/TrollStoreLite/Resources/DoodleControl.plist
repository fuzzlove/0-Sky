      <key>defaults</key><string>com.nahtedetihw.doodleprefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enable Tweak</string>
      <key>defaults</key><string>com.nahtedetihw.doodleprefs</string>
