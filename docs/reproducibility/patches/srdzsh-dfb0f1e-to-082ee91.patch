+"""Pinned Neofetch and a standalone iOS Bash scripting runtime."""
+import hashlib
+import os
+import pathlib
+import shutil
+import subprocess
+import tarfile
+import urllib.request
+
+PROJECT = pathlib.Path(__file__).resolve().parents[1]
+SOURCES = {
+    'bash-5.2.37': ('https://ftp.gnu.org/gnu/bash/bash-5.2.37.tar.gz',
+                    '9599b22ecd1d5787ad7d3b7bf0c59f312b3396d1e281175dd1f8a4014da621ff'),
+    'neofetch-7.1.0': ('https://codeload.github.com/dylanaraps/neofetch/tar.gz/refs/tags/7.1.0',
+                      '58a95e6b714e41efc804eca389a223309169b2def35e57fa934482a6b47c27e7'),
+}
+
+def source(name):
+    url, digest = SOURCES[name]
+    cache = PROJECT/'downloads'; cache.mkdir(exist_ok=True)
+    archive = cache/(name+'.tar.gz')
+    if not archive.exists():
+        with urllib.request.urlopen(url, timeout=60) as response:
+            raw = response.read(32*1024*1024)
+        if hashlib.sha256(raw).hexdigest() != digest:
+            raise ValueError(name+' download checksum mismatch')
+        temporary = archive.with_suffix('.tmp'); temporary.write_bytes(raw)
+        temporary.replace(archive)
+    if hashlib.sha256(archive.read_bytes()).hexdigest() != digest:
+        raise ValueError(name+' cached source checksum mismatch')
+    directory = PROJECT/'build'/(name+'-srd-source')
+    if not directory.exists():
+        directory.mkdir(parents=True)
+        with tarfile.open(archive) as tar:
+            for member in tar.getmembers():
+                parts = pathlib.PurePosixPath(member.name).parts[1:]
+                if not parts: continue
+                target = directory.joinpath(*parts)
+                if not target.resolve().is_relative_to(directory.resolve()) or member.issym() or member.islnk():
+                    raise ValueError('Unsafe source archive member')
+                if member.isdir(): target.mkdir(parents=True, exist_ok=True)
+                elif member.isfile():
+                    target.parent.mkdir(parents=True, exist_ok=True)
+                    target.write_bytes(tar.extractfile(member).read()); target.chmod(member.mode & 0o777)
+    return directory, archive
+
+def bundle(root, output, sdk, clang, args, licenses, run):
+    bash_source, bash_archive = source('bash-5.2.37')
+    neofetch_source, neofetch_archive = source('neofetch-7.1.0')
+    compiled = PROJECT/'build'/('bash-5.2.37-'+args.arch+'-'+args.ios_min+'-scripting')
+    compiled.mkdir(exist_ok=True)
+    binary = compiled/'bash'
+    flags = ['-isysroot',sdk,'-arch',args.arch,'-miphoneos-version-min='+args.ios_min,'-O2']
+    if not binary.exists():
+        env = os.environ.copy()
+        env.update(CC=clang, CPP=clang+' -E '+' '.join(flags), CFLAGS=' '.join(flags),
+                   CPPFLAGS='-isysroot '+sdk, LDFLAGS=' '.join(flags),
+                   # Public iPhoneOS headers omit getentropy's declaration.
+                   # Bash instead uses /dev/urandom and arc4random, both native.
+                   ac_cv_func_getentropy='no')
+        native = subprocess.check_output(['sh',str(bash_source/'support/config.guess')],text=True).strip()
+        with (compiled/'configure-output.log').open('w') as log:
+            subprocess.run(['sh',str(bash_source/'configure'),'--host=aarch64-apple-darwin',
+                            '--build='+native,'--prefix=/usr','--disable-nls','--disable-readline',
+                            '--without-bash-malloc','--disable-profiling'],
+                           cwd=compiled,env=env,stdout=log,stderr=subprocess.STDOUT,check=True,timeout=180)
+        with (compiled/'build-output.log').open('w') as log:
+            subprocess.run(['make','-j8','bash'],cwd=compiled,env=env,stdout=log,
+                           stderr=subprocess.STDOUT,check=True,timeout=180)
+    shutil.copy2(binary,root/'usr/bin/bash')
+    resource = root/'usr/share/neofetch'; resource.mkdir(parents=True)
+    shutil.copy2(neofetch_source/'neofetch',resource/'neofetch')
+    subprocess.run(['patch','--batch','--forward','-p1','-i',str(PROJECT/'patches/neofetch/0001-native-ios.patch')],
+                   cwd=resource,check=True,timeout=30)
+    run(clang,*flags,'-Wall','-Wextra',PROJECT/'app/neofetch-launcher.c','-o',root/'usr/bin/neofetch')
+    run(clang,*flags,'-Wall','-Wextra','-fobjc-arc','-framework','Foundation',PROJECT/'app/neofetch-info.m',
+        '-o',root/'usr/libexec/srd-neofetch-info')
+    manual = root/'usr/share/man/man1'; manual.mkdir(parents=True,exist_ok=True)
+    shutil.copy2(neofetch_source/'neofetch.1',manual/'neofetch.1')
+    shutil.copy2(neofetch_source/'LICENSE.md',licenses/'Neofetch-MIT.txt')
+    shutil.copy2(bash_source/'COPYING',licenses/'Bash-GPL-3.0.txt')
+    (licenses/'Neofetch-Bash-SOURCES.txt').write_text(
+        '\n'.join(name+'\n'+url+'\nSHA256 '+digest for name,(url,digest) in SOURCES.items())+
+        '\nBash: unmodified upstream source; no readline/NLS/custom allocator.\n'
+        'getentropy disabled because public iOS headers omit its declaration.\n'
+        'Neofetch: native iOS queries in neofetch/0001-native-ios.patch.\n'
+        'Corresponding source archives/build scripts accompany the DMG in sources/.\n')
+    # Distribute corresponding source, configuration and port additions with
+    # the binary artifacts. These are host resources, not cryptex runtime files.
+    sources = output/'sources'; sources.mkdir()
+    for archive in [bash_archive,neofetch_archive]: shutil.copy2(archive,sources/archive.name)
+    for path in [pathlib.Path(__file__),PROJECT/'scripts/build_app.py',PROJECT/'patches/neofetch/0001-native-ios.patch',
+                 PROJECT/'app/neofetch-info.m',PROJECT/'app/neofetch-launcher.c',compiled/'config.h',
+                 compiled/'configure-output.log']:
+        shutil.copy2(path,sources/path.name)
