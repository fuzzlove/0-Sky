@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Launch the installed native terminal's Neofetch smoke view and capture it."""
+import argparse
+import asyncio
+import pathlib
+from pymobiledevice3.remote.native_tunnel import NativeRemotedTunnel
+from pymobiledevice3.services.dvt.instruments.dvt_provider import DvtProvider
+from pymobiledevice3.services.dvt.instruments.process_control import ProcessControl
+from pymobiledevice3.services.dvt.instruments.screenshot import Screenshot
+
+async def capture(udid, output):
+    async with NativeRemotedTunnel(serial=udid) as rsd:
+        async with DvtProvider(rsd) as dvt, ProcessControl(dvt) as process:
+            pid = await process.launch('codes.liquidsky.research.srdzsh',arguments=['--neofetch-smoke'])
+            await asyncio.sleep(5)
+            async with Screenshot(dvt) as screen:
+                output.write_bytes(await screen.get_screenshot())
+            print(udid, 'native terminal launched', pid, 'screenshot', output)
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--udid',required=True)
+    parser.add_argument('--output',required=True,type=pathlib.Path)
+    args = parser.parse_args()
+    asyncio.run(capture(args.udid,args.output))
