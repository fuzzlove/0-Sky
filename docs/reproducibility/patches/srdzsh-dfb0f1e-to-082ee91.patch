+"""Executed on an SRD via an authorized SSH profile; credential supplied on stdin."""
+import json
+import os
+import re
+import select
+import shlex
+import socket
+import struct
+import sys
+import time
+
+options=json.loads(sys.stdin.read())
+sock=socket.create_connection(('127.0.0.1',22340),10)
+sock.sendall(options['key'].encode()+b'\n')
+ready=b''
+while not ready.endswith(b'\n'):
+    data=sock.recv(1)
+    if not data:raise RuntimeError('Root service rejected authentication')
+    ready+=data
+assert ready==b'READY uid=0 gid=0\n',ready
+sock.settimeout(15)
+
+def frame(kind,payload):
+    sock.sendall(bytes([kind])+struct.pack('!I',len(payload))+payload)
+
+def command(value):
+    time.sleep(.1) # Let ZLE finish restoring raw terminal input after the previous command.
+    marker=os.urandom(12).hex()
+    end=b'\x1e'+marker.encode()+b'\x1f'
+    frame(1,(value+"; printf '\\036"+marker+"\\037'\n").encode())
+    result=bytearray()
+    while end not in result:
+        data=sock.recv(65536)
+        if not data:raise RuntimeError('Shell exited during check')
+        result.extend(data)
+    return result[:result.index(end)].decode('utf-8','replace')
+
+root=command("print -r -- ROOT_IDS=$UID,$EUID; id; p=/var/root/.srdzsh-check-$$; print verified >$p; cat $p; rm $p; print -r -- SHELL=$ZSH_VERSION; tty")
+assert 'ROOT_IDS=0,0' in root and 'uid=0(root)' in root and 'verified' in root and 'SHELL=5.9.2' in root,root
+assert re.search(r'/dev/(ttys|pts/|pty)',root),root
+modules=options['modules']
+module_check=command('for m in '+' '.join(modules)+'; do zmodload $m || print -r -- FAIL_MODULE=$m; done; print -r -- MODULES_OK')
+assert 'FAIL_MODULE=' not in module_check.replace('FAIL_MODULE=$m',''),module_check
+completion=command('print -r -- COMPLETION=${+functions[compdef]}; print -r -- HISTORY=$HISTFILE; whence compinit; zmodload zsh/zpty; zpty srdcheck "print pty_module_ok; sleep 1"; zpty -r srdcheck; zpty -d srdcheck')
+assert 'COMPLETION=1' in completion and 'pty_module_ok' in completion,completion
+frame(2,struct.pack('!HH',92,31))
+resize=command('stty size')
+assert re.search(r'31\s+92',resize),resize
+paths=command('print -r -- CRYPTEX=$CRYPTEX_MOUNT_PATH; print -r -- BIN=$commands[zsh]; print -r -- TOYBOX=$commands[toybox]')
+for offset in range(0,len(options['commands']),20):
+    batch=options['commands'][offset:offset+20]
+    found=command('for c in '+' '.join(shlex.quote(c) for c in batch)+'; do whence -- "$c" >/dev/null || print -r -- MISSING=$c; done; print -r -- COMMANDS_OK')
+    assert 'MISSING=' not in found.replace('MISSING=$c',''),found
+neofetch=command('PATH=$CRYPTEX_MOUNT_PATH/usr/bin neofetch --stdout --no_config; print -r -- NEOFETCH_STATUS=$?')
+assert 'NEOFETCH_STATUS=0' in neofetch and re.search(r'OS: iOS (?:2[6-9]|[3-9][0-9])\.',neofetch),neofetch
+assert 'Host: iPhone' in neofetch and 'Shell: zsh 5.9.2' in neofetch,neofetch
+assert re.search(r'Memory: [1-9][0-9]*MiB / [1-9][0-9]*MiB',neofetch),neofetch
+assert 'GPU: prin' not in neofetch,neofetch
+neofetch_ascii=command('PATH=$CRYPTEX_MOUNT_PATH/usr/bin neofetch --no_config --ascii_distro mac_small; print -r -- NEOFETCH_ASCII_STATUS=$?')
+assert 'NEOFETCH_ASCII_STATUS=0' in neofetch_ascii and '\x1b[' in neofetch_ascii and 'iOS ' in neofetch_ascii,neofetch_ascii
+neofetch_flags=command('neofetch --version; print -r -- NEOFETCH_VERSION_STATUS=$?; neofetch --help; print -r -- NEOFETCH_HELP_STATUS=$?')
+assert 'Neofetch 7.1.0' in neofetch_flags and '--ascii_distro' in neofetch_flags,neofetch_flags
+# Upstream 7.1.0 intentionally exits 1 for both --help and --version.
+assert 'NEOFETCH_HELP_STATUS=1' in neofetch_flags and 'NEOFETCH_VERSION_STATUS=1' in neofetch_flags,neofetch_flags
