+#!/usr/bin/env python3
+"""Build the UIKit terminal, native root broker, standalone root, and IPA."""
+import argparse
+import hashlib
+import json
+import pathlib
+import plistlib
+import re
+import secrets
+import shutil
+import subprocess
+import tarfile
+import urllib.request
+from build_extras import bundle as bundle_extras
+
+PROJECT = pathlib.Path(__file__).resolve().parents[1]
+POC = PROJECT.parent
+SWIFTTERM_COMMIT = '5d14406844143538cd8f8851d2d8a67c1fe443e5' # v1.20.0
+SWIFTTERM_SHA256 = 'a25cfd051a9eb65a63dc6869bb1843bf100645160f72050f812407bd1c587d4c'
+
+def native_terminal(app,output,sdk,args,key,licenses):
+    cache=PROJECT/'downloads';cache.mkdir(exist_ok=True)
+    archive=cache/('SwiftTerm-'+SWIFTTERM_COMMIT+'.tar.gz')
+    if not archive.exists():
+        with urllib.request.urlopen('https://codeload.github.com/migueldeicaza/SwiftTerm/tar.gz/'+SWIFTTERM_COMMIT,timeout=60) as response:raw=response.read(20*1024*1024)
+        if hashlib.sha256(raw).hexdigest()!=SWIFTTERM_SHA256:raise ValueError('SwiftTerm checksum failed')
+        archive.write_bytes(raw)
+    if hashlib.sha256(archive.read_bytes()).hexdigest()!=SWIFTTERM_SHA256:raise ValueError('SwiftTerm checksum failed')
+    source=PROJECT/'build'/('SwiftTerm-'+SWIFTTERM_COMMIT)
+    if not source.exists():
+        source.mkdir(parents=True)
+        with tarfile.open(archive) as tar:
+            for member in tar.getmembers():
+                parts=pathlib.PurePosixPath(member.name).parts[1:]
+                if not parts:continue
+                target=source.joinpath(*parts)
+                if not target.resolve().is_relative_to(source.resolve()) or member.issym() or member.islnk():raise ValueError('Unsafe SwiftTerm archive member')
+                if member.isdir():target.mkdir(parents=True,exist_ok=True)
+                elif member.isfile():target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(tar.extractfile(member).read())
+    compiled=PROJECT/'build'/('SwiftTerm-ios-'+args.arch+'-'+args.ios_min);compiled.mkdir(exist_ok=True)
+    shim=compiled/'BuildInfo.swift'
+    shim.write_text('import Foundation\nextension Bundle { static var module: Bundle { Bundle.main } }\npublic enum SwiftTermBuildInfo { public static let tag: String? = "v1.20.0"; public static let branch: String? = nil; public static let commit: String? = "'+SWIFTTERM_COMMIT+'"; public static let version = "v1.20.0" }\n')
+    compiler=subprocess.check_output(['xcrun','--sdk','iphoneos','--find','swiftc'],text=True).strip()
+    flags=['-sdk',sdk,'-target',args.arch+'-apple-ios'+args.ios_min,'-swift-version','5','-O','-whole-module-optimization']
+    library=compiled/'libSwiftTerm.a'
+    if not library.exists():
+        sources=sorted((source/'Sources/SwiftTerm').rglob('*.swift'))
+        run(compiler,*flags,'-parse-as-library','-emit-library','-static','-emit-module','-module-name','SwiftTerm','-emit-module-path',compiled/'SwiftTerm.swiftmodule',*sources,shim,'-o',library)
+    session=output/'SessionKey.swift';session.write_text('let sessionCredential = '+json.dumps(key+'\n')+'\n')
+    run(compiler,*flags,'-parse-as-library','-I',compiled,'-L',compiled,'-lSwiftTerm',PROJECT/'app/NativeTerminal.swift',session,'-o',app/'SRDZsh','-Xlinker','-rpath','-Xlinker','/usr/lib/swift')
+    session.unlink()
+    shutil.copy2(source/'LICENSE',licenses/'SwiftTerm-MIT.txt')
+
+def run(*args):
+    subprocess.run([str(a) for a in args], check=True, timeout=180)
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', required=True, type=pathlib.Path)
+    parser.add_argument('--arch', default='arm64e')
+    parser.add_argument('--ios-min', default='26.0')
+    parser.add_argument('--toybox', type=pathlib.Path, default=POC/'srdsh-work/srdsh/build/com.liquidsky.srdssh.root/usr/bin/toybox')
+    parser.add_argument('--icon-source', type=pathlib.Path, default=PROJECT/'app/icons')
+    args = parser.parse_args()
+    output = args.output.resolve()
+    if output.exists():
+        raise SystemExit(f'Output already exists: {output}; choose a new --output')
+    sdk = subprocess.check_output(['xcrun','--sdk','iphoneos','--show-sdk-path'], text=True).strip()
+    clang = subprocess.check_output(['xcrun','--sdk','iphoneos','--find','clang'], text=True).strip()
+    output.mkdir(parents=True)
+    root = output/'root'
+    shutil.copytree(PROJECT/'zsh-cryptex.root', root)
+    app = root/'System/Applications/SRDZsh.app'
+    app.mkdir(parents=True)
+    (root/'usr/libexec').mkdir(parents=True)
+    key = secrets.token_hex(32)
+    (output/'session-key.h').write_text('#define SESSION_KEY "'+key+'"\n')
+    flags = ['-isysroot',sdk,'-arch',args.arch,'-miphoneos-version-min='+args.ios_min,'-O2','-I'+str(output)]
+    run(clang, *flags, '-Wall','-Wextra', PROJECT/'app/rootd.c','-o',root/'usr/libexec/srdzsh-rootd')
+    licenses=root/'usr/share/licenses/srdzsh'
+    native_terminal(app,output,sdk,args,key,licenses)
+    info = {
+        'CFBundleDisplayName':'srdzsh', 'CFBundleName':'srdzsh',
+        'CFBundleIdentifier':'codes.liquidsky.research.srdzsh',
+        'CFBundleExecutable':'SRDZsh','CFBundlePackageType':'APPL',
+        'CFBundleInfoDictionaryVersion':'6.0','CFBundleVersion':'7',
+        'CFBundleShortVersionString':'2.0.5','MinimumOSVersion':args.ios_min,
+        'LSRequiresIPhoneOS':True,'UIDeviceFamily':[1,2], 'UILaunchScreen':{},
+        'UISupportedInterfaceOrientations':['UIInterfaceOrientationPortrait','UIInterfaceOrientationLandscapeLeft','UIInterfaceOrientationLandscapeRight'],
+        'CFBundleIcons':{'CFBundlePrimaryIcon':{'CFBundleIconFiles':['AppIcon60x60']}},
+        'CFBundleIcons~ipad':{'CFBundlePrimaryIcon':{'CFBundleIconFiles':['AppIcon76x76']}},
+        'UIApplicationSceneManifest':{'UIApplicationSupportsMultipleScenes':False,
+          'UISceneConfigurations':{'UIWindowSceneSessionRoleApplication':[
+            {'UISceneConfigurationName':'Default','UISceneDelegateClassName':'SceneDelegate'}]}},
+    }
+    (app/'Info.plist').write_bytes(plistlib.dumps(info))
+    for name in ['AppIcon60x60@2x.png','AppIcon76x76@2x~ipad.png']:
+        shutil.copy2(args.icon_source/name, app/name)
+    # Bundle a native multicall binary and all enabled applets. Never overwrite zsh.
+    if not args.toybox.is_file():raise FileNotFoundError('Build SRD Toybox or pass --toybox')
+    archs=subprocess.check_output(['lipo','-archs',args.toybox],text=True).strip().split()
+    if args.arch not in archs:raise ValueError('Toybox lacks target architecture')
+    shutil.copy2(args.toybox,root/'usr/bin/toybox')
+    install_list=POC/'srdsh-work/srdsh/vendor/toybox/generated/newtoys.h'
+    config=POC/'srdsh-work/srdsh/vendor/toybox/.config'
+    enabled=set(re.findall(r'^CONFIG_(\w+)=y$',config.read_text(),re.M))
+    applets=[]
+    for symbol,command in re.findall(r'^USE_(\w+)\((?:NEWTOY|OLDTOY)\(([^,]+),',install_list.read_text(),re.M):
+        command=command.strip()
+        if symbol not in enabled or command in ['toybox','zsh'] or '/' in command:continue
+        target=root/'usr/bin'/command
+        if not target.exists():target.symlink_to('toybox')
+        applets.append(command)
+    # Replace Toybox's Bash alias with GNU Bash required by upstream Neofetch.
+    bash_alias=root/'usr/bin/bash'
+    if bash_alias.is_symlink():bash_alias.unlink()
+    bundle_extras(root,output,sdk,clang,args,licenses,run)
+    # Keep the IPA self-contained for the registrar's normal IPA intake, too.
+    shutil.copytree(root/'usr',app/'usr',symlinks=True)
+    daemon={
+        'Label':'com.liquidsky.srdzsh.rootd',
+        'ProgramArguments':['/usr/libexec/srdzsh-rootd'],
+        'UserName':'root','GroupName':'wheel','RunAtLoad':True,'KeepAlive':True,
+        'EnablePressuredExit':False,'EnableTransactions':False,
+        'ThrottleInterval':5,'ProcessType':'Interactive',
+        'StandardErrorPath':'/var/tmp/srdzsh-rootd.log',
+    }
+    launch=root/'Library/LaunchDaemons';launch.mkdir(parents=True)
+    (launch/'com.liquidsky.srdzsh.rootd.plist').write_bytes(plistlib.dumps(daemon))
+    entitlements={'platform-application':True,'com.apple.private.security.no-sandbox':True,'get-task-allow':True}
+    ent=output/'entitlements.plist';ent.write_bytes(plistlib.dumps(entitlements))
+    for binary in [base/path for base in [root,app] for path in ['usr/bin/zsh','usr/bin/toybox','usr/libexec/srdzsh-rootd','usr/bin/bash','usr/bin/neofetch','usr/libexec/srd-neofetch-info']]:
+        run('codesign','--force','--sign','-','--entitlements',ent,binary)
+        run('codesign','--verify','--strict',binary)
+    run('codesign','--force','--sign','-','--entitlements',ent,app)
+    run('codesign','--verify','--strict',app)
+    payload=output/'ipa/Payload';payload.mkdir(parents=True)
+    shutil.copytree(app,payload/'SRDZsh.app',symlinks=True)
+    run('ditto','-c','-k','--keepParent',payload,output/'SRDZsh-2.0.5.ipa')
+    shutil.rmtree(output/'ipa')
+    (output/'commands.json').write_text(json.dumps({'toybox_applets':sorted(set(applets)), 'additional_commands':['neofetch'], 'bash_version':'5.2.37', 'neofetch_version':'7.1.0', 'zsh_version':'5.9.2','app_version':'2.0.5','architecture':args.arch,'terminal_renderer':'SwiftTerm 1.20.0 UIKit/CoreGraphics'},indent=2)+'\n')
+    (output/'session-key.h').unlink() # Credential is only in signed binaries.
+    print('Built SRDZsh app/root and IPA:',output, 'Toybox applets:',len(set(applets)))
+
+if __name__=='__main__':main()
