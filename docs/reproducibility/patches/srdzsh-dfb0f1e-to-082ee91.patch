diff --git a/app/NativeTerminal.swift b/app/NativeTerminal.swift
new file mode 100644
index 0000000..2bf86a7
--- /dev/null
+++ b/app/NativeTerminal.swift
@@ -0,0 +1,195 @@
+import UIKit
+import SwiftTerm
+import Darwin
+
+final class RootConnection {
+    private let lock = NSLock()
+    private let writes = DispatchQueue(label: "srdzsh.native.input")
+    private var descriptor: Int32 = -1
+    private var generation: UInt64 = 0
+    var output: (([UInt8]) -> Void)?
+    var status: ((String, Bool) -> Void)?
+
+    func close() {
+        lock.lock(); generation &+= 1
+        let old = descriptor; descriptor = -1; lock.unlock()
+        if old >= 0 { _ = Darwin.shutdown(old, SHUT_RDWR) }
+    }
+    private func writeAll(_ bytes: [UInt8], to fd: Int32) -> Bool {
+        bytes.withUnsafeBytes { raw in
+            var offset = 0
+            while offset < raw.count {
+                let n = Darwin.send(fd, raw.baseAddress!.advanced(by: offset), raw.count-offset, 0)
+                if n < 0 && errno == EINTR { continue }
+                if n <= 0 { return false }; offset += n
+            }
+            return true
+        }
+    }
+    private func report(_ message: String, ready: Bool = false) {
+        DispatchQueue.main.async { self.status?(message, ready) }
+    }
+    func connect() {
+        close(); lock.lock(); let current = generation; lock.unlock()
+        report("Connecting to the root shell…")
+        DispatchQueue.global(qos: .userInitiated).async {
+            let fd = Darwin.socket(AF_INET, SOCK_STREAM, 0)
+            var yes: Int32 = 1
+            setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &yes, socklen_t(MemoryLayout.size(ofValue: yes)))
+            var address = sockaddr_in()
+            address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+            address.sin_family = sa_family_t(AF_INET); address.sin_port = UInt16(22340).bigEndian
+            address.sin_addr.s_addr = inet_addr("127.0.0.1")
+            let connected = withUnsafePointer(to: &address) { pointer in
+                pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                    Darwin.connect(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+                }
+            }
+            guard connected == 0 else { Darwin.close(fd); self.report("Root service unavailable. Tap New session."); return }
+            var timeout = timeval(tv_sec: 10, tv_usec: 0)
+            setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, socklen_t(MemoryLayout<timeval>.size))
+            guard self.writeAll(Array(sessionCredential.utf8), to: fd) else {
+                Darwin.close(fd); self.report("Root service disconnected."); return
+            }
+            var ready = [UInt8]()
+            while ready.count < 64 {
+                var byte: UInt8 = 0
+                guard Darwin.recv(fd, &byte, 1, 0) == 1 else { break }
+                ready.append(byte); if byte == 10 { break }
+            }
+            guard String(bytes: ready, encoding: .utf8) == "READY uid=0 gid=0\n" else {
+                Darwin.close(fd); self.report("Root authentication failed. Tap New session."); return
+            }
+            timeout.tv_sec = 0
+            setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, socklen_t(MemoryLayout<timeval>.size))
+            self.lock.lock()
+            guard self.generation == current else { self.lock.unlock(); Darwin.close(fd); return }
+            self.descriptor = fd; self.lock.unlock()
+            self.report("srdzsh · root UID 0 · interactive terminal", ready: true)
+            var buffer = [UInt8](repeating: 0, count: 32768)
+            while true {
+                let n = Darwin.recv(fd, &buffer, buffer.count, 0)
+                if n < 0 && errno == EINTR { continue }
+                if n <= 0 { break }
+                let bytes = Array(buffer.prefix(n))
+                DispatchQueue.main.async {
+                    self.lock.lock(); let valid = self.generation == current; self.lock.unlock()
+                    if valid { self.output?(bytes) }
+                }
+            }
+            self.lock.lock()
+            let active = self.generation == current
+            if active { self.descriptor = -1 }; self.lock.unlock()
+            Darwin.close(fd)
+            if active { self.report("Session closed. Tap New session.") }
+        }
+    }
+    func send(type: UInt8, bytes: [UInt8]) {
+        guard !bytes.isEmpty && bytes.count <= 65536 else { return }
+        let n = UInt32(bytes.count)
+        let framed = [type, UInt8((n >> 24) & 255), UInt8((n >> 16) & 255), UInt8((n >> 8) & 255), UInt8(n & 255)] + bytes
+        lock.lock(); let fd = descriptor; let current = generation; lock.unlock()
+        guard fd >= 0 else { return }
+        writes.async {
+            self.lock.lock(); let valid = self.generation == current && self.descriptor == fd; self.lock.unlock()
+            if valid { _ = self.writeAll(framed, to: fd) }
+        }
+    }
+    func resize(cols: Int, rows: Int) {
+        let c = UInt16(clamping: cols), r = UInt16(clamping: rows)
+        send(type: 2, bytes: [UInt8(c >> 8), UInt8(c & 255), UInt8(r >> 8), UInt8(r & 255)])
+    }
+}
+
+final class NativeTerminalController: UIViewController, TerminalViewDelegate {
+    private let terminal = TerminalView(frame: .zero)
+    private let statusLabel = UILabel()
+    private let toolbar = UIStackView()
+    private let connection = RootConnection()
+    private var keyboardHeight: CGFloat = 0
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = UIColor(red: 0.06, green: 0.08, blue: 0.11, alpha: 1)
+        statusLabel.font = .systemFont(ofSize: 13, weight: .medium)
+        statusLabel.textColor = .systemGreen; statusLabel.numberOfLines = 2
+        statusLabel.text = "srdzsh · starting root terminal"
+        terminal.terminalDelegate = self
+        terminal.font = .monospacedSystemFont(ofSize: 14, weight: .regular)
+        terminal.nativeBackgroundColor = view.backgroundColor!
+        terminal.nativeForegroundColor = UIColor(white: 0.91, alpha: 1)
+        try? terminal.setUseMetal(false)
+        toolbar.axis = .horizontal; toolbar.spacing = 6; toolbar.distribution = .fillEqually
+        for (title, action) in [("Keyboard", #selector(showKeyboard)), ("Ctrl C", #selector(interruptShell)), ("Tab", #selector(sendTab)), ("New session", #selector(newSession))] {
+            let button = UIButton(type: .system)
+            button.setTitle(title, for: .normal); button.addTarget(self, action: action, for: .touchUpInside)
+            button.titleLabel?.font = .systemFont(ofSize: 13, weight: .medium)
+            button.backgroundColor = UIColor(white: 0.14, alpha: 1); button.layer.cornerRadius = 7
+            toolbar.addArrangedSubview(button)
+        }
+        view.addSubview(statusLabel); view.addSubview(terminal); view.addSubview(toolbar)
+        terminal.feed(text: "srdzsh native terminal\r\nConnecting to the root shell…\r\n")
+        connection.output = { [weak self] bytes in self?.terminal.feed(byteArray: bytes[...]) }
+        connection.status = { [weak self] text, ready in
+            guard let self = self else { return }
+            self.statusLabel.text = text
+            if ready {
+                let model = self.terminal.getTerminal()
+                self.connection.resize(cols: model.cols, rows: model.rows)
+                if ProcessInfo.processInfo.arguments.contains("--ui-smoke") {
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
+                        self.connection.send(type: 1, bytes: Array("id; pwd; print -r -- Native_terminal_ready\n".utf8))
+                    }
+                }
+                if ProcessInfo.processInfo.arguments.contains("--neofetch-smoke") {
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 1) {
+                        self.connection.send(type: 1, bytes: Array("clear; neofetch --ascii_distro mac_small\n".utf8))
+                    }
+                }
+            }
+        }
+        NotificationCenter.default.addObserver(self, selector: #selector(keyboardChanged(_:)), name: UIResponder.keyboardWillChangeFrameNotification, object: nil)
+        UIApplication.shared.isIdleTimerDisabled = true
+        connection.connect()
+    }
+    override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        let safe = view.safeAreaInsets, width = view.bounds.width-safe.left-safe.right
+        let bottom = view.bounds.height-max(safe.bottom, keyboardHeight)
+        statusLabel.frame = CGRect(x: safe.left+10, y: safe.top, width: width-20, height: 38)
+        toolbar.frame = CGRect(x: safe.left+8, y: bottom-44, width: width-16, height: 38)
+        terminal.frame = CGRect(x: safe.left+4, y: safe.top+40, width: width-8, height: max(1,bottom-safe.top-88))
+    }
+    @objc private func keyboardChanged(_ notification: Notification) {
+        guard let end = notification.userInfo?[UIResponder.keyboardFrameEndUserInfoKey] as? CGRect else { return }
+        let rect = view.convert(end, from: nil)
+        keyboardHeight = max(0, view.bounds.height-rect.minY)
+        view.setNeedsLayout(); view.layoutIfNeeded()
+    }
+    @objc private func showKeyboard() { _ = terminal.becomeFirstResponder() }
+    @objc private func interruptShell() { connection.send(type: 1, bytes: [3]) }
+    @objc private func sendTab() { connection.send(type: 1, bytes: [9]) }
+    @objc private func newSession() { connection.connect() }
+    func sizeChanged(source: TerminalView, newCols: Int, newRows: Int) { connection.resize(cols: newCols, rows: newRows) }
+    func send(source: TerminalView, data: ArraySlice<UInt8>) { connection.send(type: 1, bytes: Array(data)) }
+    func setTerminalTitle(source: TerminalView, title: String) {}
+    func hostCurrentDirectoryUpdate(source: TerminalView, directory: String?) {}
+    func scrolled(source: TerminalView, position: Double) {}
