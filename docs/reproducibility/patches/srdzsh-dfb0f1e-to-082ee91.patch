+#!/usr/bin/env python3
+"""Verify real root PTY behavior using an explicitly authorized paired SSH route."""
+import argparse
+import json
+import pathlib
+import re
+import shlex
+import sys
+from deploy import paired_worker,PROJECT
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--udid',required=True)
+    p.add_argument('--instance',type=pathlib.Path)
+    p.add_argument('--output',type=pathlib.Path,default=PROJECT/'dist')
+    p.add_argument('--idle-seconds',type=int,default=65)
+    args=p.parse_args()
+    output=args.output.resolve()
+    raw=(output/'root/System/Applications/SRDZsh.app/SRDZsh').read_bytes()
+    keys=set(re.findall(rb'(?<![a-f0-9])[a-f0-9]{64}\n\x00',raw))
+    if len(keys)!=1:raise RuntimeError('Expected exactly one embedded session credential')
+    key=next(iter(keys))[:-2].decode()
+    modules=re.findall(r'^name=(\S+).* link=static ',(PROJECT/'build/zsh-5.9.2-arm64e/config.modules').read_text(),re.M)
+    modules=[m for m in modules if m!='zsh/main']
+    inventory=json.loads((output/'commands.json').read_text())
+    commands=inventory['toybox_applets']+inventory.get('additional_commands',[])
+    options={'key':key,'modules':modules,'commands':commands,'idle_seconds':args.idle_seconds}
+    source=(PROJECT/'tests/device_session.py').read_text()
+    # Program text is separate from the sensitive stdin credential.
+    script='import json,sys; '+ 'exec('+repr(source)+')'
+    worker,_=paired_worker(args.udid,args.instance)
+    result=worker['ssh']('/var/jb/usr/bin/python3 -c '+shlex.quote(script),input_data=json.dumps(options).encode(),timeout=max(90,args.idle_seconds+60),check=False)
+    (output/(args.udid+'-session.log')).write_bytes(result.stdout+result.stderr)
+    if result.returncode:
+        print(result.stderr.decode('utf-8','replace'),file=sys.stderr)
+        raise SystemExit(result.returncode)
+    report=json.loads(result.stdout)
+    (output/(args.udid+'-verification.json')).write_text(json.dumps(report,indent=2)+'\n')
+    print(args.udid,'PASS: real root, PTY,',len(modules),'modules,',len(commands),'commands, resize, signals,',args.idle_seconds,'seconds idle, session state and exit')
+
+if __name__=='__main__':main()
