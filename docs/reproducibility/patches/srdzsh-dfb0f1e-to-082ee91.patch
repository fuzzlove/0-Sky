+#!/usr/bin/env python3
+"""Build/install SRDZsh through exact-device Native RemoteXPC research service."""
+import argparse
+import asyncio
+import hashlib
+import importlib.util
+import json
+import os
+import pathlib
+import plistlib
+import runpy
+import shutil
+import shlex
+import subprocess
+import time
+
+from native_backend import assets_from_manifest, build, install
+
+PROJECT = pathlib.Path(__file__).resolve().parents[1]
+IDENTIFIER = 'com.liquidsky.srdzsh'
+BUNDLE_ID = 'codes.liquidsky.research.srdzsh'
+
+def paired_worker(udid, instance=None):
+    candidates=[]
+    for path in (pathlib.Path.home()/'Library/LaunchAgents').glob('com.liquidskysecurity.crypstore-worker.*.plist'):
+        definition=plistlib.loads(path.read_bytes());environment=definition.get('EnvironmentVariables',{})
+        directory=pathlib.Path(environment.get('CRYPSTORE_INSTANCE_DIR','/nonexistent'))
+        if environment.get('CRYPSTORE_DEVICE_UDID')!=udid or not (directory/'config.json').is_file():continue
+        if instance and directory.resolve()!=instance.resolve():continue
+        worker=next((pathlib.Path(arg) for arg in definition.get('ProgramArguments',[]) if arg.endswith('/crypstore_worker.py')),None)
+        if worker and worker.is_file():candidates.append((directory,environment,worker))
+    if len(candidates)!=1:
+        raise RuntimeError(f'Expected one active paired SSH instance for {udid}; found {len(candidates)}. Use --instance to select it.')
+    directory,environment,worker=candidates[0]
+    os.environ.update(environment)
+    return runpy.run_path(str(worker),run_name='srdzsh_deployment'),directory
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=pathlib.Path,default=PROJECT/'dist')
+    parser.add_argument('--udid',action='append',default=[],help='Exact paired SRD UDID; repeat for multiple devices')
+    parser.add_argument('--install',action='store_true',help='Personalize using live Apple TSS and persistently install')
+    parser.add_argument('--instance',type=pathlib.Path,help='Existing 0-Sky paired instance for SSH verification')
+    parser.add_argument('--verify',action='store_true',help='Use explicitly authorized existing root SSH profile to verify runtime')
+    parser.add_argument('--register',action='store_true',help='Register the app with the existing exact-build SRD registrar over authorized paired SSH')
+    args=parser.parse_args()
+    if (args.install or args.verify or args.register) and not args.udid:parser.error('--udid is required for device operations')
+    if args.instance and len(args.udid)!=1:parser.error('--instance requires one --udid')
+    output=args.output.resolve()
+    version=json.loads((output/'commands.json').read_text())['app_version']
+    assets_record=output/'cryptex/sdk-assets.json'
+    if not assets_record.exists():
+        work=assets_record.parent;work.mkdir(parents=True,exist_ok=True)
+        manifest=build(output/'root',IDENTIFIER,version,work)
+    else:
+        # Locate inside this distribution rather than retaining build-host
+        # absolute paths when the artifacts are copied to another directory.
+        manifests=list(assets_record.parent.glob('sdk-cryptex-*/bundles/*.cxbd/Restore/BuildManifest.plist'))
+        if len(manifests)!=1:raise RuntimeError('Expected one cryptex bundle in this output')
+        manifest=manifests[0].resolve()
+    _,assets=assets_from_manifest(manifest)
+    info=plistlib.loads(assets['Cryptex1,CryptexInfoPlist'].read_bytes())
+    if info.get('CFBundleIdentifier')!=IDENTIFIER or info.get('CFBundleVersion')!=version:
+        raise ValueError('Built cryptex identifier/version does not match the app artifacts')
+    dmg=output/('SRDZsh-'+version+'.dmg')
+    if not dmg.exists():shutil.copy2(assets['Cryptex1,GenericDmg'],dmg)
+    if hashlib.sha384(dmg.read_bytes()).digest()!=hashlib.sha384(assets['Cryptex1,GenericDmg'].read_bytes()).digest():
+        raise ValueError('Distribution DMG differs from the manifest-bound image')
+    for udid in dict.fromkeys(args.udid):
+        if args.install:
+            asyncio.run(install(manifest,IDENTIFIER,udid))
+            from pymobiledevice3.remote.native_tunnel import NativeRemotedTunnel
+            from pymobiledevice3.services.cryptexd import CryptexdService
+            async def confirm():
+                async with NativeRemotedTunnel(serial=udid) as rsd:
+                    matches=[v for v in await CryptexdService(rsd).copy_installed() if v.identifier==IDENTIFIER]
+                    if len(matches)!=1 or matches[0].version!=version:raise RuntimeError('Installed generation/version not confirmed')
+                    print('CONFIRMED installed',udid,IDENTIFIER,matches[0].version,flush=True)
+            asyncio.run(confirm())
+        if args.register:
+            worker,instance=paired_worker(udid,args.instance)
+            ssh=worker['ssh']
+            def mounted(identifier):
+                mounts='/private/var/run/com.apple.security.cryptexd/mnt/'
+                result=ssh('for d in '+mounts+shlex.quote(identifier)+'.*; do if [ -d "$d" ] && mount | grep -Fq " on $d ("; then echo "$d"; fi; done',timeout=30)
+                values=[v for v in result.stdout.decode().splitlines() if v]
+                if len(values)!=1:raise RuntimeError('Expected one active mount for '+identifier)
+                return values[0]
+            root=mounted(IDENTIFIER)
+            # Reuse the deployed updater's stale-record retirement, MCM-copy
+            # fallback, payload-identity verification, and launch validation.
+            payload=sum(p.stat().st_size for p in (output/'root/System/Applications/SRDZsh.app').rglob('*') if p.is_file() and not p.is_symlink())
+            app=worker['register_and_link'](BUNDLE_ID,'SRDZsh','SRDZsh.app',root+'/System',payload)
+            (output/(udid+'-registration.json')).write_text(json.dumps({'bundle_id':BUNDLE_ID,'app_path':app},indent=2)+'\n')
+            print('REGISTERED',udid,BUNDLE_ID,app,flush=True)
+        if args.verify:
+            worker,instance=paired_worker(udid,args.instance)
+            ssh=worker['ssh']
+            check=ssh('id; ps -A -o pid,uid,gid,comm | grep srdzsh-rootd; cat /var/tmp/srdzsh-rootd.log',timeout=30,check=False)
+            (output/(udid+'-service.log')).write_bytes(check.stdout+check.stderr)
+            print(check.stdout.decode('utf-8','replace'),flush=True)
+            subprocess.run([os.sys.executable,str(PROJECT.parent/'check_app_icon.py'),'--udid',udid,'--bundle-id',BUNDLE_ID],check=True,timeout=60)
+    print('DMG:',dmg,flush=True)
+
+if __name__=='__main__':main()
