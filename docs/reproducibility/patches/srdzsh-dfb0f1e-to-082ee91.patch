diff --git a/app/neofetch-info.m b/app/neofetch-info.m
new file mode 100644
index 0000000..a30d67f
--- /dev/null
+++ b/app/neofetch-info.m
@@ -0,0 +1,44 @@
+#import <Foundation/Foundation.h>
+#include <mach/mach.h>
+#include <sys/sysctl.h>
+#include <sys/time.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+int main(int argc, char **argv) {
+    @autoreleasepool {
+        if (argc != 2) return 2;
+        if (!strcmp(argv[1], "system-version")) {
+            NSDictionary *version = [NSDictionary dictionaryWithContentsOfFile:@"/System/Library/CoreServices/SystemVersion.plist"];
+            if (!version) return 1;
+            for (NSString *key in @[@"ProductName", @"ProductVersion", @"ProductBuildVersion"]) {
+                NSString *value = version[key];
+                if (![value isKindOfClass:NSString.class]) return 1;
+                printf("%s\n%s\n", key.UTF8String, value.UTF8String);
+            }
+        } else if (!strcmp(argv[1], "uptime")) {
+            struct timeval boot; size_t size = sizeof(boot);
+            if (sysctlbyname("kern.boottime", &boot, &size, NULL, 0)) return 1;
+            printf("%lld\n", (long long)(time(NULL) - boot.tv_sec));
+        } else if (!strcmp(argv[1], "memory")) {
+            uint64_t total; size_t size = sizeof(total);
+            if (sysctlbyname("hw.memsize", &total, &size, NULL, 0)) return 1;
+            vm_statistics64_data_t stats; mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+            mach_port_t host = mach_host_self(); vm_size_t page_size;
+            kern_return_t result = host_page_size(host, &page_size);
+            if (result == KERN_SUCCESS) result = host_statistics64(host, HOST_VM_INFO64, (host_info64_t)&stats, &count);
+            mach_port_deallocate(mach_task_self(), host);
+            if (result != KERN_SUCCESS) return 1;
+            // Match Neofetch's active + wired + compressor definition, with the
+            // actual kernel page size (16 KiB on these SRDs, not macOS's 4 KiB).
+            uint64_t used = ((uint64_t)stats.active_count + stats.wire_count + stats.compressor_page_count) * page_size;
+            printf("%llu %llu\n", (unsigned long long)(used / 1048576), (unsigned long long)(total / 1048576));
+        } else if (!strcmp(argv[1], "cpu-count")) {
+            unsigned count; size_t size = sizeof(count);
+            if (sysctlbyname("hw.ncpu", &count, &size, NULL, 0)) return 1;
+            printf("%u\n", count);
+        } else return 2;
+    }
+    return 0;
+}
diff --git a/app/neofetch-launcher.c b/app/neofetch-launcher.c
new file mode 100644
index 0000000..503282e
--- /dev/null
+++ b/app/neofetch-launcher.c
@@ -0,0 +1,32 @@
+#include <mach-o/dyld.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// Resolve the signed resources alongside this executable, including IPA copies.
+int main(int argc, char **argv) {
+    char executable[PATH_MAX], root[PATH_MAX], bash[PATH_MAX], script[PATH_MAX], helper[PATH_MAX];
+    uint32_t length = sizeof(executable);
+    if (_NSGetExecutablePath(executable, &length) || !realpath(executable, root)) return 126;
+    for (int i = 0; i < 3; ++i) {
+        char *slash = strrchr(root, '/');
+        if (!slash) return 126;
+        *slash = 0;
+    }
+    snprintf(bash, sizeof(bash), "%s/usr/bin/bash", root);
+    snprintf(script, sizeof(script), "%s/usr/share/neofetch/neofetch", root);
+    snprintf(helper, sizeof(helper), "%s/usr/libexec/srd-neofetch-info", root);
+    setenv("SRD_NEOFETCH_HELPER", helper, 1);
+    // Non-interactive Bash must not source an inherited startup file.
+    unsetenv("BASH_ENV"); unsetenv("ENV");
+    char **arguments = calloc((size_t)argc + 4, sizeof(char *));
+    if (!arguments) return 126;
+    arguments[0] = bash; arguments[1] = "--noprofile"; arguments[2] = "--norc";
+    arguments[3] = script;
+    for (int i = 1; i < argc; ++i) arguments[i + 3] = argv[i];
+    execv(bash, arguments);
+    perror("neofetch: bundled Bash");
+    return 126;
+}
diff --git a/app/rootd.c b/app/rootd.c
new file mode 100644
index 0000000..4c7c15b
--- /dev/null
+++ b/app/rootd.c
@@ -0,0 +1,136 @@
+// SRD-only local PTY broker. One authenticated connection owns one root shell.
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <grp.h>
+#include <limits.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <util.h>
+#include "session-key.h"
+
+static char root[PATH_MAX];
+static int transfer(int fd, void *buf, size_t count, int writing) {
+    unsigned char *p = buf;
+    while (count) {
+        ssize_t n = writing ? write(fd, p, count) : read(fd, p, count);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return -1;
+        p += n; count -= n;
+    }
+    return 0;
+}
+static void session(int sock) {
+    signal(SIGCHLD, SIG_DFL);
+    struct timeval auth_timeout = {10, 0};
+    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &auth_timeout, sizeof(auth_timeout));
+    char auth[65];
+    if (transfer(sock, auth, sizeof(auth), 0)) return;
+    unsigned mismatch = auth[64] ^ '\n';
+    for (int i = 0; i < 64; i++) mismatch |= auth[i] ^ SESSION_KEY[i];
+    if (mismatch) return;
+    auth_timeout.tv_sec = 0;
+    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &auth_timeout, sizeof(auth_timeout));
+    // Reject a mislabeled non-root daemon rather than pretending USER=root is sufficient.
+    if (getuid() || geteuid() || getgid() || getegid()) return;
+    char *ready = "READY uid=0 gid=0\n";
+    if (transfer(sock, ready, strlen(ready), 1)) return;
+    int master;
+    struct winsize size = {.ws_row = 24, .ws_col = 80};
+    pid_t child = forkpty(&master, NULL, NULL, &size);
+    if (child < 0) return;
+    if (child == 0) {
+        close(sock);
+        signal(SIGPIPE, SIG_DFL);
+        if (initgroups("root", 0) || setgid(0) || setuid(0)) _exit(126);
+        char shell[PATH_MAX];
+        snprintf(shell, sizeof(shell), "%s/usr/bin/zsh", root);
+        setenv("CRYPTEX_MOUNT_PATH", root, 1);
+        setenv("HOME", "/var/root", 1);
+        setenv("USER", "root", 1); setenv("LOGNAME", "root", 1);
+        setenv("SHELL", shell, 1); setenv("TERM", "xterm-256color", 1);
+        setenv("TERM_PROGRAM", "srdzsh", 1);
+        char terminfo[PATH_MAX];
+        snprintf(terminfo, sizeof(terminfo), "%s/usr/share/terminfo", root);
+        setenv("TERMINFO", terminfo, 1);
+        setenv("LANG", "en_US.UTF-8", 1);
+        setenv("PATH", "/var/jb/usr/local/bin:/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/usr/bin:/bin:/usr/sbin:/sbin", 1);
+        unsetenv("ZDOTDIR"); unsetenv("DYLD_INSERT_LIBRARIES");
+        if (chdir("/var/root")) _exit(126);
+        execl(shell, "zsh", "-il", (char *)NULL);
+        perror("zsh"); _exit(127);
+    }
+    fprintf(stderr, "session opened shell=%d uid=0\n", child);
+    struct pollfd fds[2] = {{sock, POLLIN, 0}, {master, POLLIN, 0}};
+    unsigned char buf[65536];
+    for (;;) {
+        int n = poll(fds, 2, -1); // No idle/session timeout.
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        if (fds[1].revents & POLLIN) {
+            ssize_t length = read(master, buf, sizeof(buf));
+            if (length <= 0 || transfer(sock, buf, length, 1)) break;
+        }
+        if (fds[0].revents & POLLIN) {
+            unsigned char header[5];
+            if (transfer(sock, header, 5, 0)) break;
+            uint32_t length; memcpy(&length, header + 1, 4); length = ntohl(length);
+            if (!length || length > sizeof(buf) || transfer(sock, buf, length, 0)) break;
+            if (header[0] == 1) {
+                if (transfer(master, buf, length, 1)) break;
+            } else if (header[0] == 2 && length == 4) {
+                uint16_t dims[2]; memcpy(dims, buf, 4);
+                size.ws_col = ntohs(dims[0]); size.ws_row = ntohs(dims[1]);
+                if (size.ws_col && size.ws_row) ioctl(master, TIOCSWINSZ, &size);
+            } else break;
+        }
+        if ((fds[0].revents | fds[1].revents) & (POLLHUP | POLLERR | POLLNVAL)) break;
+    }
+    close(master);
+    kill(-child, SIGHUP);
+    // Reap promptly even when a command ignores SIGHUP.
+    for (int i = 0; i < 20; i++) {
+        if (waitpid(child, NULL, WNOHANG) == child) goto done;
+        usleep(100000);
+    }
+    kill(-child, SIGKILL); waitpid(child, NULL, 0);
+done:
+    fprintf(stderr, "session closed shell=%d\n", child);
+}
+int main(int argc, char **argv) {
+    (void)argc;
+    if (getuid() || geteuid() || getgid() || getegid()) {
+        fprintf(stderr, "srdzsh-rootd requires actual uid/gid 0\n"); return 1;
+    }
+    // Derive resources from the executable; launchd need not preserve environment.
+    if (!realpath(argv[0], root)) { perror("realpath"); return 1; }
+    for (int i = 0; i < 3; i++) {
+        char *slash = strrchr(root, '/'); if (!slash) return 1; *slash = 0;
+    }
+    signal(SIGPIPE, SIG_IGN); signal(SIGCHLD, SIG_IGN);
+    int server = socket(AF_INET, SOCK_STREAM, 0), yes = 1;
+    setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
+    fcntl(server, F_SETFD, FD_CLOEXEC);
+    struct sockaddr_in address = {.sin_len = sizeof(address), .sin_family = AF_INET,
+        .sin_port = htons(22340), .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    if (bind(server, (struct sockaddr *)&address, sizeof(address)) || listen(server, 8)) {
+        perror("rootd listen"); return 1;
+    }
+    fprintf(stderr, "SRDZsh root PTY service ready\n");
+    for (;;) {
+        int sock = accept(server, NULL, NULL);
+        if (sock < 0) { if (errno == EINTR) continue; perror("accept"); return 1; }
+        fcntl(sock, F_SETFD, FD_CLOEXEC);
+        pid_t pid = fork();
+        if (pid == 0) { close(server); session(sock); close(sock); _exit(0); }
+        close(sock);
+    }
+}
