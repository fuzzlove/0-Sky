+
+    // A completed Sileo queue is not sufficient for the SRD Bridge. Every
+    // selected package must have an exact, hash-named archive staged in the
+    // app container before the privileged transaction may begin.
+    public func verifiedBridgeArchivesComplete(packageIDs: [String]) -> Bool {
+        let uniquePackageIDs = Set(packageIDs)
+        guard !uniquePackageIDs.isEmpty else { return false }
+        let directory = FileManager.default.documentDirectory
+            .appendingPathComponent("0sky-authorized-packages", isDirectory: true)
+            .standardizedFileURL
+        for packageID in uniquePackageIDs {
+            guard let archive = verifiedBridgeArchives[packageID]?.standardizedFileURL,
+                  archive.deletingLastPathComponent() == directory,
+                  archive.pathExtension == "deb",
+                  archive.deletingPathExtension().lastPathComponent.range(
+                    of: "^[0-9a-f]{64}$", options: .regularExpression) != nil else {
+                return false
+            }
+            var archiveStat = stat()
+            guard lstat(archive.path, &archiveStat) == 0,
+                  (archiveStat.st_mode & S_IFMT) == S_IFREG else { return false }
+        }
+        return true
     }
 
