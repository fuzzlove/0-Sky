+        clearConfirmCoverTap()
+        let tap = UITapGestureRecognizer(target: self,
+                                         action: #selector(confirmCoverTapped(_:)))
+        tap.cancelsTouchesInView = false
+        cover.addGestureRecognizer(tap)
+        confirmCoverView = cover
+        confirmCoverTap = tap
+    }
