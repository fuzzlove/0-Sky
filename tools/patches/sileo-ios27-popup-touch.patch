+
+    private func armConfirmCoverTapAfterPresentation() {
+        guard let confirm = confirmButton, !confirm.isHidden,
+              confirm.alpha > 0, confirm.window != nil else {
+            disarmConfirmCoverTap()
+            return
+        }
+        guard confirmCoverTapAllowedAt == .greatestFiniteMagnitude else {
+            if CACurrentMediaTime() >= confirmCoverTapAllowedAt {
+                syncConfirmCoverTap()
+            }
+            return
+        }
+        // A package row can present the popup before the finger used to tap
+        // GET has lifted. Do not attach the forwarding recognizer until that
+        // presentation gesture is over; confirmation must be a second tap.
+        confirmCoverTapAllowedAt = CACurrentMediaTime() + 0.75
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.75) { [weak self] in
+            guard let self = self,
