+        let center = confirm.convert(CGPoint(x: confirm.bounds.midX,
+                                             y: confirm.bounds.midY), to: window)
+        guard let cover = window.hitTest(center, with: nil),
+              cover !== confirm, !cover.isDescendant(of: confirm) else {
+            clearConfirmCoverTap()
+            return
+        }
