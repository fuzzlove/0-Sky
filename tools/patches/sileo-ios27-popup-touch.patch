+    private func syncConfirmCoverTap() {
+        guard ProcessInfo.processInfo.operatingSystemVersion.majorVersion >= 27,
+              CACurrentMediaTime() >= confirmCoverTapAllowedAt,
+              let window = view.window,
+              let confirm = confirmButton, !confirm.isHidden else {
+            clearConfirmCoverTap()
+            return
