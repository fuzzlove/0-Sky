+    private func awaitVerifiedBridgeInstall(remaining: Int) {
+        guard ProcessInfo.processInfo.operatingSystemVersion.majorVersion >= 27,
+              isDownloading, !isInstalling else { return }
+        let manager = DownloadManager.shared
+        if manager.verifyComplete() {
+            manager.lockedForInstallation = true
+            isDownloading = false
+            cancelDownload?.isHidden = true
+            transferToInstall()
+            TabBarController.singleton?.presentPopupController()
+            return
+        }
+        guard remaining > 0 else {
+            isDownloading = false
+            manager.queueStarted = false
+            presentConfirmFailure("Package download verification timed out. Refresh the source and retry.")
+            return
+        }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.25) { [weak self] in
+            self?.awaitVerifiedBridgeInstall(remaining: remaining - 1)
+        }
+    }
     
