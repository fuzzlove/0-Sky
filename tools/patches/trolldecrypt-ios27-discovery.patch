diff --git a/Extensions/LSApplicationProxy+AltList.m b/Extensions/LSApplicationProxy+AltList.m
index 18df009..9e13d5e 100644
--- a/Extensions/LSApplicationProxy+AltList.m
+++ b/Extensions/LSApplicationProxy+AltList.m
@@ -11,6 +11,34 @@ - (BOOL)atl_isUserApplication {
     return [self.applicationType isEqualToString:@"User"] && ![self atl_isHidden];
 }
 
+- (BOOL)atl_isResearchCryptexApplication {
+    NSURL* bundleURL = self.bundleURL;
+    if (!bundleURL.isFileURL || [self atl_isHidden]) return NO;
+    NSString* path = [[bundleURL.path stringByStandardizingPath] stringByResolvingSymlinksInPath];
+    if (![path.pathExtension isEqualToString:@"app"]) return NO;
+    NSString* applications = [path stringByDeletingLastPathComponent];
+    if (![[applications lastPathComponent] isEqualToString:@"Applications"]) return NO;
+    NSString* mount = [applications stringByDeletingLastPathComponent];
+    NSString* mountRoot = @"/private/var/run/com.apple.security.cryptexd/mnt";
+    if (![[mount stringByDeletingLastPathComponent] isEqualToString:mountRoot]) return NO;
+    return [self atl_hasValidLaunchableBundle];
+}
+
+- (BOOL)atl_hasValidLaunchableBundle {
+    NSURL* bundleURL = self.bundleURL;
+    if (!bundleURL.isFileURL) return NO;
+    NSString* path = [[bundleURL.path stringByStandardizingPath] stringByResolvingSymlinksInPath];
+    NSDictionary* info = [NSDictionary dictionaryWithContentsOfFile:[path stringByAppendingPathComponent:@"Info.plist"]];
+    NSString* identifier = info[@"CFBundleIdentifier"];
+    NSString* executable = info[@"CFBundleExecutable"];
+    if (![identifier isKindOfClass:[NSString class]] ||
+        ![identifier isEqualToString:self.atl_bundleIdentifier] ||
+        ![executable isKindOfClass:[NSString class]] ||
+        [executable isEqualToString:@""] ||
+        ![[executable lastPathComponent] isEqualToString:executable]) return NO;
+    return [[NSFileManager defaultManager] isExecutableFileAtPath:[path stringByAppendingPathComponent:executable]];
+}
+
 // the tag " hidden " is also valid, so we need to check if any strings contain "hidden" instead
 BOOL tagArrayContainsTag(NSArray* tagArr, NSString* tag) {
     if (!tagArr || !tag) return NO;
