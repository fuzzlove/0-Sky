+    // CFNetwork on iOS 27 can deliver every byte of a valid HTTP 206 response
+    // without calling URLSessionDownloadDelegate's completion callback. Only
+    // recover a file whose size and signed repository hash match exactly.
+    public func recoverVerifiedDownloads(packageIDs: [String]) -> Bool {
+        guard ProcessInfo.processInfo.operatingSystemVersion.majorVersion >= 27,
+              let candidates = try? FileManager.default.contentsOfDirectory(
+                at: EvanderNetworking.downloadCache,
+                includingPropertiesForKeys: [.isRegularFileKey, .isSymbolicLinkKey,
+                                             .fileSizeKey],
+                options: [.skipsHiddenFiles]) else { return false }
+        var complete = true
+        for packageID in packageIDs {
+            guard let download = downloads[packageID] else {
+                complete = false
+                continue
+            }
+            if download.success { continue }
+            guard download.progress == 1, download.failureReason == nil,
+                  let expectedSizeText = download.package.size,
+                  let expectedSize = Int(expectedSizeText) else {
+                complete = false
+                continue
+            }
+            var recovered = false
+            for candidate in candidates {
+                guard let values = try? candidate.resourceValues(
+                        forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey]),
+                      values.isRegularFile == true, values.isSymbolicLink != true,
+                      values.fileSize == expectedSize else { continue }
+                guard let expectedHash = download.package.rawControl["SHA256"]?.lowercased(),
+                      expectedHash.range(of: "^[0-9a-f]{64}$",
+                                         options: .regularExpression) != nil,
+                      candidate.hash(ofType: .sha256) == expectedHash else { continue }
+                do {
+                    try stageVerifiedBridgeArchive(
+                        package: download.package, fileURL: candidate)
+                    cachedFiles.append(candidate)
+                    download.task?.cancel()
+                    currentDownloads = max(0, currentDownloads - 1)
+                    download.failureReason = nil
+                    download.success = true
+                    download.completed = true
+                    download.progress = 1
+                    recovered = true
+                    break
+                } catch {
+                    download.failureReason = error.localizedDescription
+                }
+            }
+            if !recovered { complete = false }
+        }
+        return complete
+    }
     
