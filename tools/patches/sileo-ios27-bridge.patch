+
+enum SileoBridgeAPT {
+    static func request(operation: String, packages: [[String: String]]) -> (Int, String, String) {
+        guard let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first,
+              let token = try? String(contentsOf: documents.appendingPathComponent("0sky-sileo-bridge.token"),
+                                      encoding: .utf8).trimmingCharacters(in: .whitespacesAndNewlines),
+              token.count == 64 else {
+            return (126, "", "0-Sky Bridge credential is missing; repair Sileo from 0-Sky Control")
+        }
+        guard let url = URL(string: "http://127.0.0.1:48654/v1/sileo/package"),
+              let body = try? JSONSerialization.data(withJSONObject:
+                    ["operation": operation, "packages": packages]) else {
+            return (126, "", "0-Sky Bridge request could not be encoded")
+        }
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.httpBody = body
+        request.timeoutInterval = operation == "plan" ? 100 : 1200
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue(token, forHTTPHeaderField: "X-0Sky-Sileo-Token")
+        let completed = DispatchSemaphore(value: 0)
+        var answer: (Int, String, String) = (190, "", "0-Sky Bridge did not respond")
+        URLSession.shared.dataTask(with: request) { data, _, error in
+            defer { completed.signal() }
+            guard let data = data,
+                  let object = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any],
+                  let status = object["status"] as? Int else {
+                answer = (190, "", "0-Sky Bridge is unavailable: \(error?.localizedDescription ?? "invalid response")")
+                return
+            }
+            if status == 0,
+               let encoded = object["installed_status_b64"] as? String,
+               !installStatusSnapshot(encoded, in: documents) {
+                answer = (192, "", "Package changed, but Sileo could not refresh its installed-package view")
+                return
+            }
+            answer = (status, object["stdout"] as? String ?? "",
+                      object["stderr"] as? String ?? "Unknown Bridge failure")
+        }.resume()
+        if completed.wait(timeout: .now() + request.timeoutInterval + 5) == .timedOut {
+            return (124, "", "0-Sky Bridge package operation timed out")
+        }
+        return answer
+    }
+
+    private static func installStatusSnapshot(_ encoded: String,
+                                              in documents: URL) -> Bool {
+        guard encoded.utf8.count <= 6 * 1024 * 1024,
+              let data = Data(base64Encoded: encoded),
+              data.count > 0, data.count <= 4 * 1024 * 1024,
+              let prefix = String(data: data.prefix(4096), encoding: .utf8),
+              prefix.contains("Package: ") else { return false }
+        let destination = documents.appendingPathComponent("sileo-dpkg-status")
+        do {
+            try data.write(to: destination, options: .atomic)
+            try FileManager.default.setAttributes([.posixPermissions: 0o600],
+                                                  ofItemAtPath: destination.path)
+            return true
+        } catch {
+            return false
+        }
+    }
+}
