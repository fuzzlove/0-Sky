+
+    public func verifiedDownloadDiagnostic(packageIDs: [String]) -> String {
+        let candidates = (try? FileManager.default.contentsOfDirectory(
+            at: EvanderNetworking.downloadCache,
+            includingPropertiesForKeys: [.isRegularFileKey, .isSymbolicLinkKey,
+                                         .fileSizeKey],
+            options: [.skipsHiddenFiles])) ?? []
+        let candidateSizes = candidates.compactMap {
+            try? $0.resourceValues(forKeys: [.fileSizeKey]).fileSize
+        }.map(String.init).joined(separator: ",")
+        let states = packageIDs.map { packageID -> String in
+            guard let download = downloads[packageID] else {
+                return packageID + ":missing-download"
+            }
+            return packageID + ":progress=" + String(describing: download.progress) +
+                ",success=" + String(download.success) +
+                ",failure=" + (download.failureReason ?? "none") +
+                ",expected=" + (download.package.size ?? "none")
+        }.joined(separator: "; ")
+        return states + "; cache-files=" + String(candidates.count) +
+            "; cache-sizes=" + candidateSizes
+    }
     
