+    private func stageVerifiedBridgeArchive(package: Package, fileURL: URL) throws {
+        guard let sha256 = package.rawControl["SHA256"]?.lowercased(),
+              sha256.range(of: "^[0-9a-f]{64}$", options: .regularExpression) != nil else {
+            throw Error.untrustedPackage(packageID: package.package)
+        }
+        let directory = FileManager.default.documentDirectory
+            .appendingPathComponent("0sky-authorized-packages", isDirectory: true)
+        try FileManager.default.createDirectory(at: directory,
+            withIntermediateDirectories: true,
+            attributes: [.posixPermissions: 0o700])
+        let values = try directory.resourceValues(
+            forKeys: [.isDirectoryKey, .isSymbolicLinkKey])
+        guard values.isDirectory == true, values.isSymbolicLink != true else {
+            throw Error.untrustedPackage(packageID: package.package)
+        }
+        let destination = directory.appendingPathComponent(sha256 + ".deb")
+        if FileManager.default.fileExists(atPath: destination.path) {
+            try FileManager.default.removeItem(at: destination)
+        }
+        try FileManager.default.copyItem(at: fileURL, to: destination)
+        try FileManager.default.setAttributes([.posixPermissions: 0o600],
+                                              ofItemAtPath: destination.path)
+        guard destination.hash(ofType: .sha256) == sha256 else {
+            try? FileManager.default.removeItem(at: destination)
+            throw Error.hashMismatch(packageHash: sha256, refHash: "staged-copy")
+        }
+        verifiedBridgeArchives[package.packageID] = destination
+    }
     
