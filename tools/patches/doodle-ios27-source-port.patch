+// SpringBoard owns this item. It is unavailable until the first native unlock
+// after boot, when the system keypad remains the fallback.
+static NSDictionary *DoodleCredentialQuery(void) {
+    return @{(__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword,
+             (__bridge id)kSecAttrService: @"com.nahtedetihw.doodle.ios27",
+             (__bridge id)kSecAttrAccount: @"device-unlock"};
+}
+
+static NSString *DoodleStoredPasscode(void);
+
+static BOOL DoodleStorePasscode(NSString *passcode) {
+    if (![passcode isKindOfClass:NSString.class] || !passcode.length ||
+        passcode.length > 128) return NO;
+    NSData *bytes = [passcode dataUsingEncoding:NSUTF8StringEncoding];
+    if (!bytes.length || bytes.length > 1024) return NO;
+    NSMutableDictionary *entry = [DoodleCredentialQuery() mutableCopy];
+    entry[(__bridge id)kSecAttrAccessible] =
+        (__bridge id)kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly;
+    entry[(__bridge id)kSecValueData] = bytes;
+    OSStatus result = SecItemAdd((__bridge CFDictionaryRef)entry, NULL);
+    if (result == errSecDuplicateItem) {
+        NSDictionary *update = @{(__bridge id)kSecValueData: bytes,
+            (__bridge id)kSecAttrAccessible:
+                (__bridge id)kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly};
+        result = SecItemUpdate((__bridge CFDictionaryRef)DoodleCredentialQuery(),
+                               (__bridge CFDictionaryRef)update);
+    }
+    if (result != errSecSuccess ||
+        ![DoodleStoredPasscode() isEqualToString:passcode]) return NO;
+    // Retire the older release's weakly encrypted preference only after the
+    // device-only Keychain item has been written successfully.
+    NSUserDefaults *defaults = [[NSUserDefaults alloc] initWithSuiteName:domain];
+    [defaults removeObjectForKey:@"passcodeData"];
+    [defaults synchronize];
+    return YES;
+}
+
+static NSString *DoodleStoredPasscode(void) {
+    NSMutableDictionary *query = [DoodleCredentialQuery() mutableCopy];
+    query[(__bridge id)kSecReturnData] = @YES;
+    query[(__bridge id)kSecMatchLimit] = (__bridge id)kSecMatchLimitOne;
+    CFTypeRef output = NULL;
+    OSStatus result = SecItemCopyMatching((__bridge CFDictionaryRef)query, &output);
+    if (result != errSecSuccess || !output) return nil;
+    id bytes = CFBridgingRelease(output);
+    if (![bytes isKindOfClass:NSData.class]) return nil;
+    return [[NSString alloc] initWithData:bytes encoding:NSUTF8StringEncoding];
+}
 
